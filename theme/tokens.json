{
  "$schema": "../schemas/tokens.schema.json",
  "meta": {
    "name": "Monastery: stone, charcoal, beeswax and forest",
    "note": "Every value becomes a CSS variable: color.stone-50 -> --color-stone-50, semantic.accent -> --accent. Semantic values may reference other tokens as {group.key}."
  },
  "color": {
    "stone-50": "#f4f1ea",
    "stone-100": "#ebe6db",
    "stone-200": "#dcd5c6",
    "stone-300": "#c6bdaa",
    "stone-500": "#8d8474",
    "charcoal-950": "#141312",
    "charcoal-900": "#1d1c1a",
    "charcoal-800": "#292724",
    "charcoal-700": "#3b3833",
    "charcoal-600": "#55514a",
    "beeswax-200": "#efdfae",
    "beeswax-300": "#e1c67d",
    "beeswax-500": "#c8a24f",
    "beeswax-600": "#a9843a",
    "beeswax-700": "#7f6127",
    "forest-950": "#121c17",
    "forest-900": "#18261f",
    "forest-800": "#203328",
    "forest-700": "#2d4637",
    "forest-500": "#5b7766",
    "cinnabar-600": "#8f3a2b",
    "white": "#ffffff"
  },
  "semantic": {
    "bg": "{color.stone-50}",
    "bg-alt": "{color.stone-100}",
    "surface": "#fbfaf6",
    "text": "{color.charcoal-900}",
    "text-soft": "{color.charcoal-600}",
    "line": "{color.stone-200}",
    "line-strong": "{color.stone-300}",
    "accent": "{color.beeswax-500}",
    "accent-strong": "{color.beeswax-700}",
    "accent-soft": "{color.beeswax-200}",
    "dark": "{color.charcoal-900}",
    "dark-alt": "{color.forest-900}",
    "on-dark": "{color.stone-100}",
    "on-dark-soft": "#b9b2a4",
    "focus": "{color.beeswax-600}",
    "health": "{color.cinnabar-600}",
    "repose": "{color.charcoal-900}",
    "success": "{color.forest-700}",
    "danger": "{color.cinnabar-600}"
  },
  "font": {
    "display": "\"Monastery Display\", \"EB Garamond\", Georgia, serif",
    "body": "\"EB Garamond\", Georgia, \"Times New Roman\", serif"
  },
  "size": {
    "base": "clamp(1.0625rem, 0.98rem + 0.3vw, 1.1875rem)",
    "small": "0.875em",
    "lead": "clamp(1.15rem, 1.05rem + 0.5vw, 1.375rem)",
    "h1": "clamp(2.1rem, 1.4rem + 3.2vw, 4.25rem)",
    "h2": "clamp(1.6rem, 1.25rem + 1.6vw, 2.6rem)",
    "h3": "clamp(1.2rem, 1.1rem + 0.5vw, 1.45rem)"
  },
  "space": {
    "section": "clamp(4.5rem, 3rem + 7vw, 9.5rem)",
    "gutter": "clamp(1.25rem, 0.8rem + 2.2vw, 2.75rem)",
    "stack": "1.5rem"
  },
  "layout": {
    "container": "76rem",
    "narrow": "44rem",
    "wide": "90rem",
    "header": "5.5rem",
    "header-condensed": "4rem"
  },
  "radius": {
    "small": "3px",
    "card": "6px",
    "arch": "50% 50% 0 0 / 22% 22% 0 0"
  },
  "motion": {
    "slow": "900ms",
    "gentle": "500ms",
    "ease": "cubic-bezier(0.22, 0.61, 0.36, 1)"
  },
  "shadow": {
    "soft": "0 1px 2px rgba(20, 19, 18, 0.05), 0 12px 32px -18px rgba(20, 19, 18, 0.35)",
    "panel": "0 30px 60px -30px rgba(10, 10, 8, 0.6)"
  },
  "fontFaces": [
    { "family": "Monastery Display", "src": "/assets/fonts/cinzel-latin-400-normal.woff2", "weight": 400, "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122", "preload": true },
    { "family": "Monastery Display", "src": "/assets/fonts/cinzel-latin-500-normal.woff2", "weight": 500, "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122" },
    { "family": "Monastery Display", "src": "/assets/fonts/ponomar-cyrillic-400-normal.woff2", "weight": 400, "unicodeRange": "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116" },
    { "family": "Monastery Display", "src": "/assets/fonts/ponomar-cyrillic-ext-400-normal.woff2", "weight": 400, "unicodeRange": "U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F" },
    { "family": "Monastery Display", "src": "/assets/fonts/gfs-neohellenic-greek-400-normal.woff2", "weight": 400, "unicodeRange": "U+0370-0377, U+037A-037F, U+0384-038A, U+038C, U+038E-03A1, U+03A3-03FF" },
    { "family": "EB Garamond", "src": "/assets/fonts/eb-garamond-latin-400-normal.woff2", "weight": 400, "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD", "preload": true },
    { "family": "EB Garamond", "src": "/assets/fonts/eb-garamond-latin-400-italic.woff2", "style": "italic", "weight": 400, "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+2000-206F" },
    { "family": "EB Garamond", "src": "/assets/fonts/eb-garamond-latin-500-normal.woff2", "weight": 500, "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+2000-206F, U+20AC" },
    { "family": "EB Garamond", "src": "/assets/fonts/eb-garamond-latin-600-normal.woff2", "weight": 600, "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+2000-206F, U+20AC" },
    { "family": "EB Garamond", "src": "/assets/fonts/eb-garamond-cyrillic-400-normal.woff2", "weight": 400, "unicodeRange": "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116" },
    { "family": "EB Garamond", "src": "/assets/fonts/eb-garamond-cyrillic-400-italic.woff2", "style": "italic", "weight": 400, "unicodeRange": "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116" },
    { "family": "EB Garamond", "src": "/assets/fonts/eb-garamond-cyrillic-500-normal.woff2", "weight": 500, "unicodeRange": "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116" },
    { "family": "EB Garamond", "src": "/assets/fonts/eb-garamond-cyrillic-600-normal.woff2", "weight": 600, "unicodeRange": "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116" },
    { "family": "EB Garamond", "src": "/assets/fonts/eb-garamond-greek-400-normal.woff2", "weight": 400, "unicodeRange": "U+0370-0377, U+037A-037F, U+0384-038A, U+038C, U+038E-03A1, U+03A3-03FF" },
    { "family": "EB Garamond", "src": "/assets/fonts/eb-garamond-greek-400-italic.woff2", "style": "italic", "weight": 400, "unicodeRange": "U+0370-0377, U+037A-037F, U+0384-038A, U+038C, U+038E-03A1, U+03A3-03FF" },
    { "family": "EB Garamond", "src": "/assets/fonts/eb-garamond-greek-500-normal.woff2", "weight": 500, "unicodeRange": "U+0370-0377, U+037A-037F, U+0384-038A, U+038C, U+038E-03A1, U+03A3-03FF" },
    { "family": "EB Garamond", "src": "/assets/fonts/eb-garamond-greek-600-normal.woff2", "weight": 600, "unicodeRange": "U+0370-0377, U+037A-037F, U+0384-038A, U+038C, U+038E-03A1, U+03A3-03FF" }
  ]
}
