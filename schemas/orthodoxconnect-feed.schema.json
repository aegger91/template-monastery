{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "items"
  ],
  "additionalProperties": true,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "startsAt"
        ],
        "properties": {
          "kind": {
            "enum": [
              "workday",
              "pilgrimage",
              "volunteer",
              "event"
            ]
          },
          "slots": {
            "type": "object",
            "properties": {
              "needed": {
                "type": "number"
              },
              "filled": {
                "type": "number"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  }
}
